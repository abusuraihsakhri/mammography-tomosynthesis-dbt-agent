{
  "openapi": "3.1.0",
  "info": {
    "title": "DBT Sentinel — Synthetic Numeric Rules API",
    "description": "Demonstration-only numeric threshold checks. No DICOM analysis, DBT reconstruction, clinical validation, or medical-device functionality.",
    "version": "2.1.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory demonstration counters",
        "responses": {
          "200": {
            "description": "JSON counters (not Prometheus text)"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate synthetic numeric inputs using fixed demo cutoffs",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Demonstration dossier and in-memory audit-chain HMAC"
          },
          "422": {
            "description": "Invalid numeric values or detected identifier pattern"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock supervisory reply",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read audit metadata using configured X-Audit-Token",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "403": {
            "description": "Invalid or missing token"
          },
          "503": {
            "description": "Read token not configured"
          }
        },
        "parameters": [
          {
            "name": "X-Audit-Token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Required when AUDIT_READ_TOKEN is configured; otherwise endpoint unavailable"
          }
        ]
      }
    },
    "/": {
      "get": {
        "summary": "Serve standalone demonstration interface",
        "responses": {
          "200": {
            "description": "Static HTML"
          }
        }
      }
    }
  }
}
